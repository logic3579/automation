{
  "log": {
    "loglevel": "warning",
    "access": "{{ xray_log_dir }}/access.log",
    "error": "{{ xray_log_dir }}/error.log"
  },
  "inbounds": [
{% if xray_protocol == "vless-reality" %}
    {
      "port": {{ xray_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {"id": "{{ xray_uuid }}", "flow": "xtls-rprx-vision"}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_reality_dest }}",
          "xver": 0,
          "serverNames": {{ xray_reality_server_names | to_json }},
          "privateKey": "{{ xray_reality_private_key }}",
          "shortIds": {{ xray_reality_short_ids | to_json }}
        }
      }
    }
{% else %}
    {
      "port": {{ xray_port }},
      "protocol": "vmess",
      "settings": {
        "clients": [
          {"id": "{{ xray_uuid }}", "alterId": 0}
        ]
      }
    }
{% endif %}
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "blocked"}
  ]
}
